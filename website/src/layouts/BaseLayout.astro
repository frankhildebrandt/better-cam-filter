---
import '../styles/global.css';
import { repository, url } from '../lib/site';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/404\/?$/, '/404.html'), Astro.site);
const socialImage = new URL(url('media/bettercam-social.png'), Astro.site);
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111914" />
    <title>{title === 'BetterCam' ? 'BetterCam — Dein Bild. Dein Hintergrund.' : `${title} · BetterCam`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('media/icon-128.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="BetterCam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BetterCam – Dein Bild. Dein Hintergrund. Native macOS-Kamera, lokal verarbeitet, Open Source." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href={url('sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand" href={url()} aria-label="BetterCam Startseite"><img src={url('media/icon-128.png')} alt="" width="36" height="36" />BetterCam<span class="brand-tag">für macOS</span></a>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <a href={url('docs/')} aria-current={current.includes('/docs') ? 'page' : undefined}>Dokumentation</a>
        <a href={url('marketing/')} aria-current={current.includes('/marketing') ? 'page' : undefined}>Media Kit</a>
        <a class="github-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div><a class="brand" href={url()}>BetterCam</a><p>Dein Bild. Dein Hintergrund. Dein Mac.</p></div>
      <div class="footer-links"><a href={url('docs/build/')}>Selbst bauen</a><a href={url('marketing/')}>Media Kit</a><a href={`${repository}/blob/main/LICENSE`}>MIT-Lizenz</a><a href={repository}>Quellcode ↗</a></div>
      <p class="copyright">© 2026 Frank Hildebrandt · Mit Astro gebaut.</p>
    </footer>
  </body>
</html>
